{
  "name": "@saas-js/conditions-react",
  "description": "Headless React bindings and composition helpers for @saas-js/conditions",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "@saas-js": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target browser --production --packages=external && bun run build:types",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.test.json --noEmit"
  },
  "peerDependencies": {
    "@saas-js/conditions": ">=0.0.1",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@saas-js/conditions": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14",
    "zod": "4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/saas-js/saas-js.git",
    "directory": "packages/conditions-react"
  }
}
