{
  "name": "@saas-js/conditions-zero",
  "description": "Convert @saas-js/conditions queries to Zero (ZQL) where expressions",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "@saas-js": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target browser --production --packages=external && bun run build:types",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.test.json --noEmit"
  },
  "peerDependencies": {
    "@rocicorp/zero": ">=1.0.0",
    "@saas-js/conditions": ">=0.0.1"
  },
  "devDependencies": {
    "@rocicorp/zero": "^1.9.0",
    "@saas-js/conditions": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/saas-js/saas-js.git"
  }
}
