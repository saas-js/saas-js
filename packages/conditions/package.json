{
  "name": "@saas-js/conditions",
  "description": "A headless condition expression engine for filters and rule builders",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "sjs": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=16384' tsup --config tsup.config.ts",
    "lint": "TIMING=1 eslint src/**/*.ts* --fix",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest run --watch"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/saas-js/saas-js.git",
    "directory": "packages/conditions"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@tanstack/store": "^0.11.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vitest": "^4.0.14",
    "zod": "4.1.5"
  }
}
