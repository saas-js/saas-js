{
  "type": "module",
  "scripts": {
    "dev:website": "bun --filter website dev",
    "build:packages": "bun --filter './packages/drizzle-crud' --filter './packages/saas-js-iconify' build",
    "release": "bun run build:packages && bun changeset publish",
    "copy-schema": "bun run scripts/copy-schema.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@changesets/cli": "^2.27.11",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "prettier": "^3.4.2",
    "tailwind-variants": "^0.3.0",
    "vitest": "^3.2.4",
    "bun": "^1.3.10"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "storybook": "^10.5.8",
    "tailwindcss": "^3.4.18",
    "vite": "^6.1.0"
  },
  "workspaces": [
    "website",
    "packages/*",
    "examples/*"
  ],
  "overrides": {
    "drizzle-orm": "1.0.0-rc.4"
  }
}